# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# IMPORTANT: use the SESSION pooler (port 5432 on *.pooler.supabase.com), not the
# direct db.<ref>.supabase.co host (IPv6-only) and not the 6543 transaction pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Shared secret that Vapi sends back in the x-vapi-secret header on tool calls.
# Generate any random string; set the same value in the Vapi assistant config.
VAPI_SERVER_SECRET=change-me-to-a-long-random-string

# Set to "false" in production to reject unauthenticated tool calls.
ALLOW_UNAUTHENTICATED_TOOLS=true
